{
  "name": "@lemonldap-ng/lib-saml",
  "version": "0.10.0",
  "description": "SAML utilities and server management for LemonLDAP::NG",
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LemonLDAPNG/lemonldap-ng.js.git"
  },
  "license": "GPL-2.0-or-later",
  "maintainers": [
    {
      "name": "Xavier Guimard",
      "email": "yadd@debian.org"
    }
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.15.21",
    "lasso.js": "0.2.2",
    "rollup": "^4.40.2",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "Lemonldap::NG",
    "SSO",
    "SAML",
    "SAML2",
    "IdP",
    "SP",
    "Federation",
    "Lasso"
  ]
}
