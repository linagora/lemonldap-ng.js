{
  "name": "@lemonldap-ng/lib-oidc",
  "version": "0.10.0",
  "description": "OIDC utilities and cryptographic functions for LemonLDAP::NG",
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LemonLDAPNG/lemonldap-ng.js.git"
  },
  "license": "GPL-2.0-or-later",
  "maintainers": [
    {
      "name": "Xavier Guimard",
      "email": "yadd@debian.org"
    }
  ],
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.15.21",
    "rollup": "^4.40.2",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "Lemonldap::NG",
    "SSO",
    "OIDC",
    "OpenID Connect",
    "JWT",
    "JWE",
    "JWK",
    "jose"
  ]
}
